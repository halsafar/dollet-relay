<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written XMLTV for the synthetic instance. One awkward form per element:
  an entity reference in a title, a channel with several <display-name>s, a
  channel with no icon, a guide channel nothing maps to, a channel new to this
  feed, and three different ways of writing a timestamp.
-->
<tv generator-info-name="synthetic" generator-info-url="https://guide.example/">
  <channel id="synth.sports">
    <display-name>Synth Sports Guide</display-name>
    <display-name lang="fr">Synth Sports (FR)</display-name>
    <icon src="https://logos.example/synth-sports.png" />
  </channel>
  <channel id="synth.news">
    <display-name>Synth News Guide</display-name>
  </channel>
  <channel id="synth.gap">
    <display-name>Synth Gap Guide</display-name>
  </channel>
  <channel id="synth.unmapped">
    <display-name>Synth Unmapped Guide</display-name>
  </channel>
  <channel id="synth.newcomer">
    <display-name>Synth Newcomer Guide</display-name>
  </channel>
  <programme start="20260915120000 +0000" stop="20260915140000 +0000" channel="synth.sports">
    <title>Rock &amp; Roll &lt;Live&gt;</title>
    <sub-title>Part One</sub-title>
    <desc>An ampersand, an angle bracket and an apostrophe: it&apos;s all here.</desc>
    <category>Sports</category>
    <episode-num system="xmltv_ns">1.4.</episode-num>
    <new />
  </programme>
  <programme start="20260915140